{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Seat Recommendation and Booking",
    "output": "docs/diagrams/seat-recommendation-and-booking.html",
    "viewBox": [1080, 900],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "locale": "en"
  },
  "participants": [
    { "id": "user", "type": "external", "label": "User", "sublabel": "attendee" },
    { "id": "browser", "type": "frontend", "label": "Browser", "sublabel": "React application" },
    { "id": "api", "type": "backend", "label": "API", "sublabel": "Express + booking service" },
    { "id": "database", "type": "database", "label": "PostgreSQL", "sublabel": "venues, seats, bookings" }
  ],
  "segments": [
    { "from": 150, "to": 345, "label": "Recommend seats" },
    { "from": 360, "to": 605, "label": "Book selected seats" },
    { "from": 620, "to": 800, "label": "Refresh seat map" }
  ],
  "messages": [
    { "id": "request-recommendation", "from": "user", "to": "browser", "y": 165, "label": "Request best seats", "variant": "default" },
    { "id": "recommendation-request", "from": "browser", "to": "api", "y": 195, "label": "POST /api/venues/:id/best-seats", "variant": "emphasis" },
    { "id": "availability-read", "from": "api", "to": "database", "y": 230, "label": "Read venue + available seats", "variant": "default" },
    { "id": "availability-result", "from": "database", "to": "api", "y": 265, "label": "Seat records and status", "variant": "return" },
    { "id": "recommendation-result", "from": "api", "to": "browser", "y": 300, "label": "200 recommendation JSON", "variant": "return" },
    { "id": "highlight-recommendation", "from": "browser", "to": "user", "y": 330, "label": "Highlight suggested seats", "variant": "return" },
    { "id": "click-book", "from": "user", "to": "browser", "y": 375, "label": "Click Book These Seats", "variant": "default" },
    { "id": "booking-request", "from": "browser", "to": "api", "y": 410, "label": "POST /api/bookings with venueId + seatIds", "variant": "emphasis" },
    { "id": "claim-seats", "from": "api", "to": "database", "y": 445, "label": "BEGIN; mark AVAILABLE seats BOOKED", "variant": "emphasis" },
    { "id": "claim-count", "from": "database", "to": "api", "y": 480, "label": "Return affected-row count", "variant": "return" },
    { "id": "create-booking", "from": "api", "to": "database", "y": 515, "label": "Insert booking + seat links", "variant": "default" },
    { "id": "commit-booking", "from": "database", "to": "api", "y": 550, "label": "COMMIT; created booking + seats", "variant": "return" },
    { "id": "booking-confirmed", "from": "api", "to": "browser", "y": 585, "label": "201 booking JSON", "variant": "return" },
    { "id": "refresh-request", "from": "browser", "to": "api", "y": 630, "label": "GET /api/venues/:id", "variant": "default" },
    { "id": "refresh-query", "from": "api", "to": "database", "y": 665, "label": "Read current venue seat map", "variant": "default" },
    { "id": "refresh-result", "from": "database", "to": "api", "y": 700, "label": "Seat map includes BOOKED status", "variant": "return" },
    { "id": "refresh-response", "from": "api", "to": "browser", "y": 735, "label": "200 refreshed seat map", "variant": "return" },
    { "id": "show-confirmation", "from": "browser", "to": "user", "y": 770, "label": "Show confirmation + booked seats", "variant": "return" }
  ],
  "activations": [
    { "participant": "browser", "from": 190, "to": 745, "type": "frontend" },
    { "participant": "api", "from": 192, "to": 710, "type": "backend" },
    { "participant": "database", "from": 218, "to": 680, "type": "database" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Recommendation is read-only",
      "items": [
        "The API checks availability and returns suggested seat IDs",
        "Seats are not reserved until the user clicks Book These Seats"
      ]
    },
    {
      "dot": "emerald",
      "title": "Booking is transactional",
      "items": [
        "Only rows still marked AVAILABLE can be claimed",
        "The affected-row count must match the requested seat count",
        "A conflict rolls back; success returns 201 and refreshes the map"
      ]
    }
  ]
}
